{
  "name": "@dokploy/cli",
  "description": "A CLI to manage dokploy server remotely",
  "version": "0.30.7",
  "author": "Mauricio Siu",
  "licenses": [
    {
      "type": "MIT",
      "url": "https://github.com/Dokploy/cli/blob/master/LICENSE"
    }
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "dokploy": "./dist/index.js"
  },
  "bugs": "https://github.com/Dokploy/cli/issues",
  "dependencies": {
    "axios": "^1.20.0",
    "chalk": "^5.6.2",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.1",
    "@types/node": "^18.19.130",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "/dist"
  ],
  "homepage": "https://github.com/Dokploy/cli",
  "keywords": [
    "dokploy",
    "cli"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "type": "module",
  "repository": "Dokploy/cli",
  "scripts": {
    "build": "tsc -b && tsx scripts/write-build-info.ts",
    "build:agent-safe": "tsx scripts/build-agent-safe.ts",
    "generate": "tsx scripts/generate.ts",
    "generate:agent-safe": "tsx scripts/generate.ts --agent-safe",
    "prebuild": "pnpm run generate",
    "dev": "tsx src/index.ts",
    "check": "biome check scripts src/agent src/client.ts src/commands src/index.ts src/env-document.ts src/record-fill.ts src/redact.ts tests && tsc -b --pretty false",
    "lint": "pnpm run check",
    "fmt": "biome check --write scripts src/agent src/client.ts src/commands src/index.ts src/env-document.ts src/record-fill.ts src/redact.ts tests",
    "format": "pnpm run fmt",
    "fix": "pnpm run fmt",
    "pretest": "tsc -b --force && tsx scripts/write-build-info.ts",
    "test": "vitest run --maxWorkers=2"
  },
  "types": "dist/index.d.ts",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
