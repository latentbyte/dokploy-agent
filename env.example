DOKPLOY_URL=https://your-dokploy-instance.example.com
DOKPLOY_API_KEY=replace-me
# DOKPLOY_AUTH_TOKEN can be used instead of DOKPLOY_API_KEY
# DOKPLOY_CONFIG_PATH=/path/to/config.json
# DOKPLOY_AGENT_BLACKLIST_PATH=/path/to/command-blacklist.json
# Agent deploy policy lives in DOKPLOY_CONFIG_PATH or ~/.config/dokploy/config.json.
# Keep that JSON file mode 0600 because it also contains the Dokploy API token.
# Set agentDeployPolicy.domainSuffixes to ["*.apps.example.net"] for create-only,
# globally unused single-label domains. Use servers[].domainSuffixes to narrow by server.
# Set agentDeployPolicy.servers to "*" to allow local and all remote Dokploy servers.
# Prefer agentDeployPolicy.expandedProjects for elevated application ops outside projects[].
# Omit applicationNames to allow every app in a project; list names to restrict within that project.
