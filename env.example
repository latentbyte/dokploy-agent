DOKPLOY_URL=https://your-dokploy-instance.example.com
DOKPLOY_API_KEY=replace-me
# DOKPLOY_AUTH_TOKEN can be used instead of DOKPLOY_API_KEY
# DOKPLOY_CONFIG_PATH=/path/to/config.json
# DOKPLOY_AGENT_BLACKLIST_PATH=/path/to/command-blacklist.json
# Agent deploy policy lives in DOKPLOY_CONFIG_PATH or ~/.config/dokploy/config.json.
# Use agentDeployPolicy.servers[].domainSuffixes to bind servers to domain wildcards.
